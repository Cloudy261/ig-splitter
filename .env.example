# Copy this file to .env and fill it in. docker compose reads .env automatically.

# Host names / IPs you open the UI with, comma-separated. localhost and 127.0.0.1 always work.
# Example: 192.168.1.20,myserver,myserver.local
IG_SPLITTER_HOSTS=

# Login: "on" (default) or "off".
#   on:  needs the password hash below; the container refuses to start without one.
#   off: no password at all. Only do this on a network you trust, or behind a
#        reverse proxy that does its own authentication.
IG_SPLITTER_LOGIN=on

# Password hash for the login. Create it with:
#   docker compose run --rm ig-splitter python app.py --hash-password
# and paste the whole line (pbkdf2-sha256:...) here.
IG_SPLITTER_PASSWORD_HASH=

# Optional: address and port on the server (default 0.0.0.0:8765).
# IG_SPLITTER_BIND=0.0.0.0
# IG_SPLITTER_PORT=8765

# Optional: where photos and exported tiles are stored on the server (default ./data).
# The folders must be writable by UID 1000, the user inside the container.
# IG_SPLITTER_DATA=./data
